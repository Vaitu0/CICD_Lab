# Copy to .env and fill in real values:
#   cp .env.example .env
# Never commit .env

# Bind address for published ports (nginx, Zabbix, …):
#   127.0.0.1  — only this machine
#   0.0.0.0    — all interfaces (lab / LAN)
#   192.168.x.x — specific NIC / VPN IP
VPN_IP=127.0.0.1

# Still published on the host (not behind nginx yet)
ZABBIX_PORT=8080

# Not used for host port mapping anymore (hello-app / grafana use expose only).
# Kept optional for local debugging if you temporarily add ports: again.
# APP_PORT=5000
# GRAFANA_PORT=3000

# Image tag for local/manual compose runs.
# CI overrides this with the git commit SHA (IMAGE_TAG from the workflow).
IMAGE_TAG=dev

# Zabbix Postgres (zabbix-db). Change the password for anything beyond a throwaway lab.
POSTGRES_USER=zabbix
POSTGRES_PASSWORD=change-me
POSTGRES_DB=zabbix
